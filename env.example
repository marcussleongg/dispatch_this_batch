# Copy to .env.local (starter convention) or .env, then fill in.
#   cp env.example .env.local
#
# Only TWO sets of credentials are needed: LiveKit + Moss.
# STT / LLM / TTS all run through LiveKit Inference — no Deepgram / Cartesia /
# OpenAI keys to manage.

# ─── LiveKit (voice runtime, Inference for STT/LLM/TTS, agent dispatch) ───────
# Easiest: `lk app env -w -d .env.local` writes these for you.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Moss — Phase 1 guidebook retrieval (not needed for Phase 0) ─────────────
# From https://portal.usemoss.dev
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=guidebook
MOSS_MODEL_ID=moss-minilm

# ─── Model overrides (optional) ──────────────────────────────────────────────
# LiveKit Inference LLM the orchestrator uses by default.
INFERENCE_LLM_MODEL=openai/gpt-5.2-chat-latest

# ─── LLM provider + model selection ──────────────────────────────────────────
# LLM_PROVIDER controls which backend handles LLM calls. STT + TTS always use
# LiveKit Inference regardless of this setting.
#
#   inference    (default) — no extra keys needed beyond LIVEKIT_*
#   truefoundry  — OpenAI-compatible gateway; set TRUEFOUNDRY_* below and run:
#                  uv sync --extra truefoundry
LLM_PROVIDER=inference

# Global model fallback (used if no per-role override is set).
# inference default: openai/gpt-5.2-chat-latest
# truefoundry: must be an exact deployment name, name set for virtual models
LLM_MODEL=

# Per-role model overrides (optional — each falls back to LLM_MODEL if unset).
# Roles: CALL_TAKER (caller-facing), LIAISON (places agency call), AGENCY_SIM (plays the agency)
LLM_CALL_TAKER_MODEL=
LLM_LIAISON_MODEL=
LLM_AGENCY_SIM_MODEL=

# Fallback model used when the primary returns a 400 error (e.g. virtual model
# routes to a stricter backend). Uses the same provider/credentials as primary.
# Per-role: LLM_CALL_TAKER_FALLBACK_MODEL, LLM_LIAISON_FALLBACK_MODEL, etc.
LLM_FALLBACK_MODEL=

# TrueFoundry gateway credentials (required only when LLM_PROVIDER=truefoundry).
# Base URL: strip trailing /chat/completions — use just the v1 prefix
TRUEFOUNDRY_BASE_URL=
TRUEFOUNDRY_API_KEY=

# ─── Later phases (placeholders) ─────────────────────────────────────────────
UNSILOED_API_KEY=
TAVILY_API_KEY=
